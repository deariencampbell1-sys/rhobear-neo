# rhobear-neo — the review-and-merge gate (sibling to rhobear-reviews).

[Unit]
Description=rhobear-neo — the review-and-merge gate (sibling to rhobear-reviews)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rhobear/rhobear-neo
# Secrets are delivered by /opt/rhobear/bin/vault-env (ExecStartPre) into
# /run/rhobear-neo/env (dir 0700, file 0600), loaded via EnvironmentFile=.
# The vault is never read by systemd or by the app; values never appear in
# the journal.
RuntimeDirectory=rhobear-neo rhobear-neo-gh
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/env PATH=/usr/bin:/bin /opt/rhobear/bin/vault-env rhobear-neo
EnvironmentFile=-/run/rhobear-neo/env
Environment=NEO_GITHUB_APP_ID=4347986
Environment=RHOBEAR_GH_APP_OWNER=deariencampbell1-sys
Environment=RHOBEAR_GH_APP_CACHE=/run/rhobear-neo-gh
# The DeepSeek-swapped `claude` CLI + `gh` live on PATH; the gh-app wrapper
# goes first and the login user's PATH follows.
Environment=PATH=/opt/rhobear/gh-app:/usr/local/bin:/usr/bin:/bin:/opt/rhobear/rhobear-neo/.venv/bin
ExecStart=/opt/rhobear/rhobear-neo/.venv/bin/python -m src
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
